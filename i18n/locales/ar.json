  "home": {
    "aboutTitle": "من نحن",
    "aboutDescription": "مخزن ٧ هي شركة متكاملة لخدمات تصميم الأفلام تأسست عام ٢٠٢٠. تعمل كمركز يضم مرافق متعددة تشمل دار تصميم أفلام، ومستودع إكسسوارات ،ستوديو أزياء، وورشة تنفيذ وبناء ديكورات. كما تغطي جميع جوانب العمل الفني داخل الشاشة وخارجها؛ بدءًا من المفهوم والبحث والتصميم، وصولًا إلى التنفيذ وتجهيز المواقع.",
    "contactTitle": "تواصل معنا",
    "heroDescription": "شركة لخدمات تصميم الأفلام تأسس في عام ٢٠٢٠ تختص في تصميم الإنتاج، والذي يشمل جميع عناصر الفن على الشاشة وعلى المسرح، بدءًا من التصور والبحث والتصميم وصولاً إلى الأدوات والملابس البناء وتجهيز المواقع."
  },
  "about": {
    "aboutTitle": "\u0639\u0646 \u0645\u062e\u0632\u0646",
    "aboutDescription": "\u062a\u064f\u0628\u0646\u0649 \u0639\u0645\u0644\u064a\u0629 \u0627\u0628\u062a\u0643\u0627\u0631 \u0627\u0644\u0641\u0646 \u0648\u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0639\u0644\u0649 \u062c\u0648\u0647\u0631 \u062c\u0645\u0639 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u062f\u0645\u062c\u0647\u0627 \u0644\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0648\u0627\u0644\u0625\u0628\u062f\u0627\u0639. \u0645\u062e\u0632\u0646 \u0667 \u064a\u062c\u0645\u0639 \u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0648\u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0648\u0627\u0644\u0642\u0635\u0635 \u0648\u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u0627\u062a \u0625\u0644\u0649 \u0648\u0627\u0642\u0639. \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0628\u0634\u0643\u0644 \u0631\u0626\u064a\u0633\u064a \u0639\u0644\u0649 \u0627\u0644\u0641\u0646 \u0627\u0644\u0633\u0627\u0628\u0639 - \u0627\u0644\u0633\u064a\u0646\u0645\u0627\u060c \u064a\u0644\u062a\u0632\u0645 \u0645\u062e\u0632\u0646 \u0667 \u0628\u062a\u0642\u062f\u064a\u0645 \u0623\u0639\u0644\u0649 \u0645\u0639\u0627\u064a\u064a\u0631 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0625\u0646\u062a\u0627\u062c \u0648\u0627\u0644\u0625\u062e\u0631\u0627\u062c \u0627\u0644\u0641\u0646\u064a.",
    "servicesTitle": "\u0627\u0644\u062e\u062f\u0645\u0627\u062a",
    "servicesDescription": "\u064a\u0642\u062f\u0645 \u0645\u062e\u0632\u0646 \u0667 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u062a\u0634\u0645\u0644 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u0627\u062a\u060c \u0648\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0634\u0627\u0645\u0644\u0629\u060c \u0648\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0625\u0646\u062a\u0627\u062c. \u064a\u0636\u0645 \u0641\u0631\u064a\u0642 \u0645\u062e\u0632\u0646 \u0667 \u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0645\u062d\u0644\u064a\u064a\u0646 \u0630\u0648\u064a \u0645\u0647\u0627\u0631\u0627\u062a \u0639\u0627\u0644\u064a\u0629 \u064a\u0644\u062a\u0632\u0645\u0648\u0646 \u0628\u0645\u0639\u0627\u064a\u064a\u0631 \u062f\u0648\u0644\u064a\u0629 \u0627\u0633\u062a\u062b\u0646\u0627\u0626\u064a\u0629 \u0644\u062a\u0642\u062f\u064a\u0645 \u062d\u0644\u0648\u0644 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629 \u0644\u0644\u0623\u0641\u0644\u0627\u0645 \u0648\u0627\u0644\u062a\u0644\u0641\u0632\u064a\u0648\u0646 \u0648\u0627\u0644\u0645\u0633\u0631\u062d \u0648\u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0625\u0628\u062f\u0627\u0639\u064a\u0629.",
